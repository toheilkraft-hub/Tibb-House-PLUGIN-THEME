# WordPress runtime directory — regenerated by scripts/setup-wordpress.sh on every import.
# Only the two hand-crafted config files are tracked; everything else (WP core, uploads,
# SQLite db, symlinks) is created at runtime.
/wordpress/
!/wordpress/wp-config.php
!/wordpress/router.php

# Uploaded reference/attachment files (ephemeral, not app source)
/attached_assets/
