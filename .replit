modules = ["nodejs-20", "php-8.2", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

# ── Project (default run button) ──────────────────────────────────────────────
# Runs setup first (idempotent — fast if already configured), then starts
# both the WordPress PHP server and the Vite proxy that exposes it in preview.
[[workflows.workflow]]
name = "Project"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/setup-wordpress.sh"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WordPress Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: web"

# ── WordPress Server (PHP built-in server) ────────────────────────────────────
[[workflows.workflow]]
name = "WordPress Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:6000 -t wordpress wordpress/router.php"
waitForPort = 6000

[workflows.workflow.metadata]
outputType = "console"

# ── Vite proxy (exposes WordPress in the preview pane) ────────────────────────
[[workflows.workflow]]
name = "artifacts/api-server: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
waitForPort = 22729
env = { PORT = "22729" }

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
